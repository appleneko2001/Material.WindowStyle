<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assists="clr-namespace:Material.WindowStyle.Assists"
                    xmlns:chrome="clr-namespace:Material.WindowStyle.Chrome">
    <!-- Window title bar button theme -->
    <ControlTheme x:Key="MaterialTitleBarButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="assists:MaterialTitleBarButtonAssist.OnHover"
                Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Panel Name="PART_RootPanel">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"/>
                        
                        <Border Name="PART_StateIndicator"
                                Background="{TemplateBinding (assists:MaterialTitleBarButtonAssist.OnHover)}"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <!-- default state -->
        <Style Selector="^ /template/ Border#PART_StateIndicator">
            <Setter Property="Opacity" Value="0"/>
        </Style>
    
        <!-- button in hovered state -->
        <Style Selector="^:pointerover /template/ Border#PART_StateIndicator">
            <Setter Property="Opacity" Value="0.12"/>
        </Style>
    
        <!-- button in focused state --> 
        <Style Selector="^:focus /template/ Border#PART_StateIndicator">
            <Setter Property="Opacity" Value="0.04"/>
        </Style>
    
        <!-- button in clicked state -->
        <Style Selector="^:pressed /template/ Border#PART_StateIndicator">
            <Setter Property="Opacity" Value="0.22"/>
        </Style>
    </ControlTheme>
    
    <ControlTheme x:Key="MaterialWindowTheme"
                  TargetType="Window">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        
        <!-- those two properties holds possibility shows drop-shadow of window -->
        <Setter Property="SystemDecorations" Value="BorderOnly"/>
        <Setter Property="ExtendClientAreaChromeHints" Value="SystemChrome"/>
        
        <!-- try less step on installation -->
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
        
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_VisualRootPanel">
                    <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                    <VisualLayerManager>
                        <VisualLayerManager.ChromeOverlayLayer>
                            <chrome:MaterialTitleBar Name="PART_TitleBar"/>
                        </VisualLayerManager.ChromeOverlayLayer>
                        <Border Name="PART_TopLevelChrome">
                            <Panel Name="PART_ContentPanel"
                                   Background="{TemplateBinding Background}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Panel>
                        </Border>
                    </VisualLayerManager>
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ Panel#PART_ContentPanel">
            <Setter Property="Margin" Value="0,32,0,0"/>
        </Style>
        
        <Style Selector="^[WindowState=FullScreen] /template/ Panel#PART_ContentPanel">
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <Style Selector="^.mini-titlebar /template/ Panel#PART_ContentPanel">
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>
        
        <Style Selector="^.mini-titlebar /template/ 
            chrome|MaterialTitleBar#PART_TitleBar">
            <Setter Property="Height" Value="24"/>
        </Style>
        
        <Style Selector="^.mini-titlebar /template/ 
            chrome|MaterialTitleBar#PART_TitleBar">
            <Setter Property="Height" Value="24"/>
        </Style>
        
        <!-- ExtendClientAreaChromeHints="NoChrome" will make window without drop-shadow -->
        <!-- this style chains will add a drop-shadow in app view spot -->
        <!--
        <Style Selector="Window[WindowState=Normal], Window[WindowState=Maximized]">
            <Style Selector="^ /template/ Border#PART_TopLevelChrome">
                <Setter Property="Margin" Value="8"/>
                <Setter Property="BoxShadow" Value="0 1 8 4 #50020202"/>
            </Style>
            
            <Style Selector="^ /template/ Panel#PART_ContentPanel">
                <Setter Property="Margin" Value="8"/>
            </Style>
        </Style>-->
        
        <!-- WindowsOS: window wraps padding from OS window manager while window was maximised and the system decorations was Full-->
        <!-- this style will apply another 8dp margin to correct it. -->
        <!-- To use this fix, apply classes to your window: 'windows-platform-fix' -->
        <!-- conflicts: app-chrome shadow -->
        <Style Selector="^.windows-platform-fix[WindowState=Maximized][SystemDecorations=Full] /template/ Panel#PART_VisualRootPanel">
            <Setter Property="Margin" Value="8"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
